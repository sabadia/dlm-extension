{
  "manifest_version": 3,
  "name": "DLM spike",
  "version": "0.0.1",
  "background": { "scripts": ["background.js"] },
  "permissions": [
    "downloads",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "nativeMessaging",
    "tabs",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "dlm-spike@example.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
