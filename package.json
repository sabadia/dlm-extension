{
  "name": "dlm-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension for DLM",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir .output/firefox-mv3",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "preact": "^11.1.0"
  }
}
